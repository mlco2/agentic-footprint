{
  "name": "af-debug-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:real": "vite --mode real",
    "build": "vite build",
    "preview": "vite preview",
    "preview:real": "vite preview --mode real",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:hex": "node ./scripts/lint-hex.js",
    "lint:arith": "node ./scripts/lint-arith.js",
    "gen:types": "node ./scripts/gen-types.mjs",
    "gen:types:check": "node ./scripts/gen-types-check.mjs",
    "test": "vitest run",
    "e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "happy-dom": "^20.11.1",
    "json-schema-to-typescript": "^15.0.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/source-serif-4": "^5.3.0"
  }
}
